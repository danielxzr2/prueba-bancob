{
  "name": "prueba-bancob",
  "version": "0.1.0",
  "description": "Plataforma básica de selección de practicantes",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "node scripts/e2e-browser.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "public/js/validation.js",
      "!src/server.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielxzr2/prueba-bancob.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2",
    "express-session": "^1.19.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}

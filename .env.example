# Copia este archivo como .env para cambiar la configuración local.
# Todos los valores son opcionales: sin .env el proyecto usa estos mismos valores por defecto.
PORT=3000
DATABASE_PATH=data/app.sqlite
UPLOADS_DIR=uploads

# Secreto para firmar la cookie de sesión. Si se omite, se genera uno aleatorio en cada
# arranque (las sesiones se cierran al reiniciar el servidor).
SESSION_SECRET=

# Analista que crea `npm run seed`. Si se omite la contraseña, se genera una aleatoria.
ANALYST_USERNAME=analista
ANALYST_PASSWORD=
